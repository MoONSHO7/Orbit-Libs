package-as: LibOrbitColorPicker-1.0

move-folders:
  LibOrbitColorPicker-1.0/LibOrbitColorPicker-1.0: LibOrbitColorPicker-1.0

manual-changelog:
  filename: .release-notes.md
  markup-type: markdown

ignore:
  - LICENSE
  - README.md
  - LibOrbitColorPicker-1.0.toc
  - "LibOrbitColorPicker-1.0/*.md"
  - .github
  - .packager
  - .scripts
  - .pkgmeta
  - .gitignore
  - .gitattributes
  - .stylua.toml
  - .styluaignore

enable-nolib-creation: no
